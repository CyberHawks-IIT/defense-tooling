# IIS on web logs the fields backlog.md's web-portal detection needs
# (client IP, URI, status). See CLAUDE.md's monitoring rollout plan step 4
# follow-up.
# IIS access logging comes from IIS's ETW output, not the W3C log files
# (2026-09-30). HTTP.SYS writes the file log in batches of up to ~60s
# whatever the settings (DisableLogBuffering and IIS 10's
# flushByEntryCountW3CLog were both tested live and neither helps), so an IIS
# detection waited up to a minute before its line even reached the disk.
# cyber-range's detection_logging role sets logTargetW3C = "File,ETW" and
# enables the Microsoft-IIS-Logging/Logs channel, which receives each request
# as event 6200 within about a second. The files are still written on the
# host; they are just no longer forwarded (the same requests would otherwise
# be indexed twice).
splunk_uf_win_monitor_channels_extra:
  - channel: Microsoft-IIS-Logging/Logs
    renderXml: true
    sourcetype: "XmlWinEventLog:Microsoft-IIS-Logging/Logs"
    index: iis
