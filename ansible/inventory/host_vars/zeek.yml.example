# Zeek's monitor config — host-specific because the demo box (also in
# splunk_forwarders) has none of these paths and shouldn't inherit them.
# See ansible/inventory/group_vars/all.yml.example.
#
# sourcetype here must be the literal "zeek" so Splunk_TA_zeek's shipped
# [zeek] stanza (on the indexer) applies and its autotype transform
# reclassifies each log by filename into zeek:conn/zeek:dns/etc.
splunk_uf_monitor_path: /opt/zeek/logs/current
splunk_uf_sourcetype_placeholder: zeek
splunk_uf_monitor_files:
  - conn.log
  - dns.log
  - dce_rpc.log
  - kerberos.log
  - ldap.log
  # Connection-open log for the directory-service ports (see the zeek_sensor
  # role's cyberhawks.zeek): the LDAP Query detection uses it for the ADWS
  # client IP and the ldap-vs-ldaps label, at query time instead of on close.
  - conn_open.log

# Step 4 (CLAUDE.md, monitoring rollout plan): a dedicated index instead of
# the default "main" — see splunk_indexer's dt_detection_content_indexes.conf.
splunk_uf_index: zeek
