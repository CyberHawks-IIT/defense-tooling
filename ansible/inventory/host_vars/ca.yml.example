# IIS logging on ca is specifically for ESC8 (AD CS HTTP web enrollment,
# the "CertSrv" virtual directory under the Default Web Site): the
# certificate request itself is in the Security log (4886/4887, forwarded via
# the whitelist below), but only the IIS log records that the request came
# over HTTP to /certsrv, and from which client IP. See CLAUDE.md's
# monitoring rollout plan step 4 follow-up.
# IIS access logging comes from IIS's ETW output, not the W3C log files
# (2026-09-30). HTTP.SYS writes the file log in batches of up to ~60s
# whatever the settings (DisableLogBuffering and IIS 10's
# flushByEntryCountW3CLog were both tested live and neither helps), so an IIS
# detection waited up to a minute before its line even reached the disk.
# cyber-range's detection_logging role sets logTargetW3C = "File,ETW" and
# enables the Microsoft-IIS-Logging/Logs channel, which receives each request
# as event 6200 within about a second. The files are still written on the
# host; they are just no longer forwarded (the same requests would otherwise
# be indexed twice).
splunk_uf_win_monitor_channels_extra:
  - channel: Microsoft-IIS-Logging/Logs
    renderXml: true
    sourcetype: "XmlWinEventLog:Microsoft-IIS-Logging/Logs"
    index: iis

# Certificate Services auditing (cyber-range's "SQL Server telemetry +
# Certificate Services auditing" work) lands in ca's own Security log as
# event IDs 4886-4899 — extends the common Security whitelist rather than
# adding a second [WinEventLog://Security] stanza, see
# splunk_uf_win_security_whitelist_extra's own comment in
# group_vars/splunk_forwarders_windows/monitor.yml.
splunk_uf_win_security_whitelist_extra: "4886,4887"
