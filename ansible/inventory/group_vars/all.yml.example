# Copy to all.yml and fill in your own values. all.yml is gitignored.
# See ../../docs/add-ons.md for where the downloaded files referenced below
# come from.

# --- zeek_sensor role ---
# The capture interface must already exist as a second NIC on the sensor
# (firewall=0, no IP) before running this role — see
# ../../docs/manual-prerequisites.md. This role does not create the NIC
# itself (that's a Proxmox host-level `pct set`, out of Ansible's reach from
# inside the guest).
zeek_capture_interface: eth1
zeek_management_interface: eth0

# --- splunk_indexer role ---
splunk_deb_path: /path/to/splunk-enterprise.deb
splunk_admin_password: "changeme"          # vault this in a real deployment
splunk_addons_dir: /path/to/downloaded/addons   # directory of .tgz/.spl files
splunk_receiving_port: 9997

# --- splunk_indexer role: DB Connect / SQL Server telemetry ---
# (monitoring rollout plan step 4 follow-up — see CLAUDE.md). This is the
# CURRENT admin password (for REST calls against an already-running
# instance), not splunk_admin_password above (that one's seed-only and left
# blank after first start, per its own comment) — vault this in a real
# deployment.
splunk_dbconnect_admin_password: "changeme"
# The dedicated svc-sqlmonitor SQL login's password — cyber-range generates
# this the same way it generates svc_mssql_password.txt etc. (see that
# repo's CLAUDE.md), so read it directly rather than duplicating it here.
splunk_dbconnect_sqlmonitor_password: "{{ lookup('ansible.builtin.file', '/path/to/cyber-range/ansible/generated/svc_sqlmonitor_password.txt') | trim }}"
# One entry per SQL Server host — the instance folder name in each path
# differs by SQL Server version (confirmed live via
# SERVERPROPERTY('InstanceDefaultLogPath')-adjacent paths on each host, not
# guessed).
splunk_dbconnect_mssql_hosts:
  - name: sql1
    host: "{{ hostvars['sql1'].ansible_host }}"
    xe_file_path: 'C:\Program Files\Microsoft SQL Server\MSSQL13.MSSQLSERVER\MSSQL\Log\detection_sql_text*.xel'
    audit_file_path: 'C:\SQLAudit\*.sqlaudit'
  - name: sql2
    host: "{{ hostvars['sql2'].ansible_host }}"
    xe_file_path: 'C:\Program Files\Microsoft SQL Server\MSSQL16.MSSQLSERVER\MSSQL\Log\detection_sql_text*.xel'
    audit_file_path: 'C:\SQLAudit\*.sqlaudit'

# --- splunk_forwarder role ---
# Only what's genuinely shared across every Linux forwarder (Zeek, the demo
# box, and anything else in the splunk_forwarders group) belongs here.
splunk_uf_deb_path: /path/to/splunkforwarder-linux.deb
splunk_uf_admin_password: "changeme"       # vault this in a real deployment
splunk_uf_indexer_host: "{{ hostvars['splunk'].ansible_host }}"
splunk_uf_indexer_port: "{{ splunk_receiving_port }}"

# splunk_uf_monitor_path/monitor_files/sourcetype_placeholder/index are all
# deliberately NOT set here — every one of them differs per host (Zeek's
# log dir + 5-file allowlist + "zeek_placeholder" sourcetype + "zeek" index
# vs. the demo box's auditd log + "linux_audit" sourcetype + "linux" index),
# so they live in host_vars/zeek.yml.example and host_vars/demo.yml.example
# instead — see CLAUDE.md's "Per-host monitor config must not live in
# group_vars/all.yml" gotcha for why this one bit us before, and monitoring
# rollout plan step 4 for the "zeek"/"windows"/"linux" index split (each
# has its own indexes.conf stanza in splunk_indexer's dt_detection_content
# app — a forwarder pointed at an index that doesn't exist there will still
# accept the data, just via Splunk auto-creating it with default settings,
# which usually isn't what you want).

# --- splunk_forwarder_windows role ---
splunk_uf_win_msi_path: /path/to/splunkforwarder-windows.msi
splunk_uf_win_admin_password: "{{ vault_windows_admin_password }}"
splunk_uf_win_indexer_host: "{{ hostvars['splunk'].ansible_host }}"
splunk_uf_win_indexer_port: "{{ splunk_receiving_port }}"

# Deliberately left unset here — this is the one exception to "put shared
# vars in all.yml": every AD member needs the same baseline channels, but
# the two DCs need one extra (Directory Service, for 1644), so the real
# values live in group_vars/splunk_forwarders_windows/ (the common set) and
# host_vars/dc1.yml + host_vars/dc2.yml (the DC-only addition), combined as:
#   splunk_uf_win_monitor_channels: "{{ splunk_uf_win_monitor_channels_common + splunk_uf_win_monitor_channels_extra }}"
#
# See CLAUDE.md's monitoring rollout plan step 3 for the channel-vs-event-ID
# granularity decision. Summary: Security, System, Directory Service, and
# Windows Defender/Operational are all high-volume-or-noisy relative to what
# backlog.md actually needs from them, so each gets an explicit `whitelist`
# of just the Event IDs in question. Sysmon/Operational, WMI-Activity/
# Operational, and WinRM/Operational are left unfiltered (whole channel) —
# Sysmon is already scoped at the source by its own config, and the other
# two are narrow-purpose channels with no meaningful volume in this lab.
#
# group_vars/splunk_forwarders_windows/monitor.yml:
#   splunk_uf_win_monitor_channels_common:
#     - channel: Security
#       whitelist: "1102,4624,4625,4656,4657,4662,4663,4673,4674,4697,4698,4720,4728,4732,4741,4756,4768,4769,4771,5136,5137,5145"
#     - channel: System
#       whitelist: "104,7040,7045"
#     - channel: Microsoft-Windows-Sysmon/Operational
#       renderXml: true
#       sourcetype: "XmlWinEventLog:Microsoft-Windows-Sysmon/Operational"
#     - channel: Microsoft-Windows-WMI-Activity/Operational
#     - channel: Microsoft-Windows-WinRM/Operational
#     - channel: Microsoft-Windows-Windows Defender/Operational
#       whitelist: "5001-5013"
#   splunk_uf_win_monitor_channels_extra: []
#   splunk_uf_win_index: windows
#
# The Sysmon renderXml/sourcetype pair is monitoring rollout plan step 4
# (CLAUDE.md): Splunk_TA_microsoft_sysmon's field extractions (Image,
# CommandLine, GrantedAccess, PipeName, etc.) are only defined for the
# XML-rendered sourcetype — every other channel above uses Splunk's native
# "WinEventLog:<channel>" default (no override needed) since that already
# matches what Splunk_TA_windows expects.
#
# host_vars/dc1.yml.example and host_vars/dc2.yml.example show the DC-only
# addition (Directory Service, whitelist "1644").
