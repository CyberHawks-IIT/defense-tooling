# Deployed by the splunk_indexer role to splunk_app_db_connect/local/db_connections.conf.
# No secrets here -- a connection only references an identity by name
# (see db_connections.conf.spec); the identity itself (which does hold the
# password) is created through DB Connect's own REST API instead, since its
# password field expects an already-encrypted value.
#
# customizedJdbcUrl (not the plain host/port/database fields, which build
# an unencrypted URL via generic_mssql's own jdbcUrlFormat) is required here
# -- confirmed live: the Microsoft JDBC driver defaults `encrypt` to true
# regardless of which URL template is used unless the connection string
# says otherwise, so the "unencrypted" template alone still attempted a TLS
# handshake and failed cert validation against sql1/sql2's self-signed
# default cert (PKIX path building failed). `encrypt=false` opts back out
# of that default explicitly; there's no dedicated on/off field for it in
# db_connections.conf.spec.
{% for item in splunk_dbconnect_mssql_hosts %}
[{{ item.name }}_mssql]
connection_type = generic_mssql
identity = {{ splunk_dbconnect_identity_name }}
customizedJdbcUrl = jdbc:sqlserver://{{ item.host }}:1433;databaseName=master;selectMethod=cursor;encrypt=false

{% endfor %}
