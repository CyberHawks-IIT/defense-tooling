{% for ch in splunk_uf_win_monitor_channels %}
[WinEventLog://{{ ch.channel }}]
disabled = 0
index = {{ splunk_uf_win_index }}
{% if ch.sourcetype is defined and ch.sourcetype %}
sourcetype = {{ ch.sourcetype }}
{% endif %}
{% if ch.renderXml is defined and ch.renderXml %}
renderXml = 1
{% endif %}
{% if ch.whitelist is defined and ch.whitelist %}
whitelist = {{ ch.whitelist }}
{% endif %}

{% endfor %}
