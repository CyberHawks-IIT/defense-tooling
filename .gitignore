# Real inventory/vars — contain hostnames, IPs, and (unless vaulted) passwords.
# group_vars lives under inventory/ (not directly under ansible/) so Ansible
# actually auto-discovers it — it only searches relative to the inventory
# file's own directory and the playbook's directory, not the repo root.
ansible/inventory/hosts.yml
ansible/inventory/group_vars/all.yml
ansible/inventory/group_vars/*.yml
!ansible/inventory/group_vars/*.yml.example
ansible/inventory/group_vars/**/vault.yml
ansible/inventory/host_vars/
ansible/.vault_pass

# Downloaded Splunk add-ons dropped here for splunk_addons_dir.
ansible/files/addons/

# Downloaded Splunk packages / add-ons — never commit these (large, and
# redistributing Splunk binaries isn't ours to do).
*.deb
*.msi
*.tgz
*.spl
